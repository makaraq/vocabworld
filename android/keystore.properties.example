# Copy to android/keystore.properties (git-ignored) and fill in real values to enable
# signed release builds (./gradlew bundleRelease). Generate the keystore with:
#
#   keytool -genkeypair -v -keystore sprind-release.keystore -alias sprind \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the .keystore file backed up OUTSIDE git — losing it means you can never
# publish an update to the same Play Store listing.

storeFile=../sprind-release.keystore
storePassword=CHANGE_ME
keyAlias=sprind
keyPassword=CHANGE_ME
