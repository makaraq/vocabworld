<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen flashcard widget (FlashcardWidgetProvider). The text set here is
     what the widget picker's preview shows; the provider replaces all of it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:text="Sprind"
                android:textColor="#D9FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_button"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_widget_play" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/widget_card_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_image"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="4dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_word"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="¡Hola!"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_translation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="Hello"
                    android:textColor="#C0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/widget_empty"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_button"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_widget_prev" />

            <TextView
                android:id="@+id/widget_counter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1 / 30"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_button"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
