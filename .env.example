# Environment Variables for Vocab World App
# Copy this file to .env.local and add your actual API keys

# Gemini AI API Key (for translations and TTS)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (for premium TTS)
NEXT_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Azure Speech Service (optional)
NEXT_PUBLIC_AZURE_SPEECH_KEY=your_azure_key_here
NEXT_PUBLIC_AZURE_REGION=your_azure_region_here

# Google Cloud TTS (optional)
NEXT_PUBLIC_GOOGLE_TTS_API_KEY=your_google_tts_key_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Vocab World

# RevenueCat Configuration
# Get all keys from https://app.revenuecat.com → Project Settings → API Keys
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_api_key_here
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_api_key_here
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_your_web_api_key_here
REVENUECAT_API_KEY=your_revenuecat_server_api_key_here
# Set this same value in RC Dashboard → Integrations → Webhooks → Authorization header
REVENUECAT_WEBHOOK_SECRET=your_webhook_secret_here
