# Environment Variables for Vocab World App
# Copy this file to .env.local and fill in your actual values.
#
# IMPORTANT: Variables WITHOUT the NEXT_PUBLIC_ prefix are server-side only.
# Variables WITH NEXT_PUBLIC_ are embedded in the JS bundle and visible to all users.
# Never put API keys or secrets in NEXT_PUBLIC_ variables.

# App Configuration (public — safe as NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Vocab World

# Supabase (anon key is safe as NEXT_PUBLIC_ — it's designed to be public)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gemini AI — SERVER-SIDE ONLY, no NEXT_PUBLIC_ prefix
GEMINI_API_KEY=your_gemini_api_key_here

# Azure Speech Service — SERVER-SIDE ONLY, no NEXT_PUBLIC_ prefix
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Apple OAuth
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key
APPLE_SHARED_SECRET=your_apple_shared_secret

# Backblaze B2
B2_APPLICATION_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME_2=your_second_bucket_name
B2_APPLICATION_KEY_ID_2=your_second_b2_key_id
B2_APPLICATION_KEY_2=your_second_b2_application_key

# RevenueCat SDK keys (safe as NEXT_PUBLIC_ — designed for client-side SDK use)
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_api_key_here
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_api_key_here
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_your_web_api_key_here

# RevenueCat server-side secrets — SERVER-SIDE ONLY
REVENUECAT_API_KEY=your_revenuecat_server_api_key_here
REVENUECAT_WEBHOOK_SECRET=your_webhook_secret_here

# Resend — transactional email for the trial-ending reminder cron. SERVER-SIDE ONLY.
RESEND_API_KEY=re_your_resend_api_key_here

# Secret guarding the daily cron at /api/cron/trial-reminders. SERVER-SIDE ONLY.
# Set the same value in Vercel → it auto-sends it as the cron's Authorization header.
# Use any long random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=your_random_cron_secret_here
